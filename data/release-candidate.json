    "privacy": "https://moshequ.github.io/autonomous-game-lab/privacy.html",
    "support": "https://moshequ.github.io/autonomous-game-lab/support.html",
    "hostedPrivacyStatus": "hosted"
  },
  "controls": {
    "zeroPaidSpend": true,
    "noExternalAccountCreation": true,
    "noWorkflowExecution": true,
    "noStoreSubmission": true,
    "noRevenueEnablement": true,
    "contentHashesRecorded": true,
    "postDeploySmokeRequired": true
  },
