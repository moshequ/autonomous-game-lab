  "cachePolicy": [
    {
      "pattern": "/assets/*",
      "cacheControl": "public, max-age=31536000, immutable",
      "reason": "Vite emits content-hashed immutable assets."
    },
    {
      "pattern": "/*.html",
      "cacheControl": "no-cache",
      "reason": "HTML entrypoints should reveal the newest build quickly."
    },
    {
